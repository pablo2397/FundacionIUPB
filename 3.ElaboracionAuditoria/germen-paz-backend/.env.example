# Copia este archivo como ".env" y ajusta los valores antes de ejecutar la app.
# NUNCA subas el archivo ".env" real a un repositorio.

# --- Aplicación ---
APP_NAME="Germen de Paz - API de Productos"
ENVIRONMENT=development
DEBUG=true

# --- Base de datos ---
DATABASE_URL=sqlite:///./germen_paz.db

# --- Seguridad / JWT ---
# Genera una clave segura, por ejemplo con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_GENERADA_ALEATORIAMENTE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Seed del admin inicial (se crea automáticamente al arrancar la app) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@germendepaz.org
ADMIN_PASSWORD=CambiaEstaClave123!

# --- CORS (orígenes permitidos, separados por comas) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate limiting del login ---
LOGIN_RATE_LIMIT=5/minute
